# Local Supabase publishable key: run `npx supabase status` in C:\dev\storylingo and copy PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Online only (Vercel): the cloud project's URL, e.g. https://abcdefgh.supabase.co, and its publishable key above.
# Leave empty locally: the app then goes through the /sb rewrite (next.config.ts).
NEXT_PUBLIC_SUPABASE_URL=

# Online only: SHOW_EDITIONS=1 shows the editions overview at / and draft editions (for the owner; never in marketing).
# SHOW_EDITIONS=

# Server only (docs/stripe.md): Stripe's secret key (test: sk_test_...), the webhook's signing secret, and Supabase's
# secret key (it writes purchases). Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
# STRIPE_AUTOMATIC_TAX=1
# Online: 1 once the Stripe keys and webhook are set (docs/stripe.md); without it products have a waitlist.
# NEXT_PUBLIC_PAYMENTS=1
