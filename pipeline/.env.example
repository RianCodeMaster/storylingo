# Loaded automatically by storylingo.py from pipeline/.env (git-ignored). Copy this file to .env.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Local Supabase: run `npx supabase status` in C:\dev\storylingo and copy SECRET_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional overrides
DEEPSEEK_MODEL=deepseek-flash
# GEMINI_IMAGE_MODEL=   (default: newest flash image model)
# GEMINI_TTS_MODEL=     (default: newest flash tts model)
# GEMINI_VOICE=Puck

# ElevenLabs voices (provider: elevenlabs in content/languages/<code>.yaml). Text to Speech access is enough.
ELEVENLABS_API_KEY=

# Stripe keys for `storylingo.py stripe` (docs/stripe.md): the test key by default, the live one with `stripe live`.
STRIPE_SECRET_TESTKEY=
STRIPE_SECRET_KEY=
