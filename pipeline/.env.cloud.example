# The cloud project (docs/cloud.md). Copy to .env.cloud (git-ignored) and fill in from the Supabase dashboard:
# Project Settings > API (URL, secret key) and Project Settings > Database > Connection string (URI, session pooler).
# Everything not set here (DeepSeek, local generator) comes from .env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
